  "changes": [
    {
      "function": "serverConstruct",
      "cause": "Two spinlock acquisitions were unchecked, and bConstructed was published before all resources existed.",
      "fix": "Check every owned acquisition, publish bConstructed last, and unwind only acquired locks, allocated client buckets, initialized policy lists and allocator ownership. Preserve configuration installed by _rmapiLockAlloc; do not clear the whole server object.",
      "actual_failure_ordinals": [
        124,
        128
      ]
    },
    {
      "function": "sysConstruct_IMPL failed path",
      "cause": "Failure cleanup destroyed child objects, cleared g_pSys and freed thread-state/TLS globals before rmapiShutdown; genuine resource free callbacks still needed those dependencies.",
      "fix": "Run rmapiShutdown while system, child objects and TLS are live, then free thread state, RM locks and children, and finally clear g_pSys. This follows normal sysDestruct dependency order.",
      "actual_failure_ordinals": [
        144,
        145,
        146
      ]
    },
    {
      "function": "rmapiLockAcquire / _sysDestroyMemExportClient",
      "cause": "Failed TLS allocation after acquiring the RW lock called ordinary release, which attempted to release a nonexistent TLS entry; the memory-export destructor then ignored the failed acquire and released an unowned lock.",
      "fix": "Unwind the genuinely acquired RW lock without releasing nonexistent TLS. If acquisition refuses, leave the memory-export client owned by the existing rmapiShutdown/serverFreeDomain path, which performs its real resource-tree cleanup. Do not call Free or release a lock after failed acquire.",
      "actual_failure_ordinals": [
        147,
        148
      ],
      "preserved_diagnostic": "The original TLS allocation-failure assertion remains visible; no failed case or diagnostic is suppressed."
    }
  ],
