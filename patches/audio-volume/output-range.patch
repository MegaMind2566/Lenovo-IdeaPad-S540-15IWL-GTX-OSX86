+// The full output range is opt-in and only valid for the observed analog DAC.
+bool VoodooHDADevice::s540OutputRangeFixEnabled(PcmDevice *pcmDevice)
+{
+	if (!mEnableS540OutputRangeFix || !mEnableVolumeChangeFix ||
+	    !s540InputGainFixEnabled(pcmDevice) || pcmDevice->digital ||
+	    pcmDevice->playChanId < 0 || pcmDevice->playChanId >= mNumChannels)
+		return false;
+	const int assoc = mChannels[pcmDevice->playChanId].assocNum;
+	if (assoc < 0 || assoc >= pcmDevice->funcGroup->audio.numAssocs ||
+	    pcmDevice->funcGroup->audio.assocs[assoc].digital)
+		return false;
+	bool found = false;
+	AudioControl *control;
+	for (int i = 0; (control = audioCtlEach(pcmDevice->funcGroup, i)); i++) {
+		if (!control->enable || !control->widget || control->step <= 0 ||
+		    (control->widget->bindAssoc != assoc && control->widget->bindAssoc != -2))
+			continue;
+		if (found || control->widget->bindAssoc != assoc ||
+		    control->widget->nid != 2 || control->dir != HDA_CTL_OUT ||
+		    control->index != 0 || control->ossmask != SOUND_MASK_PCM ||
+		    control->step != 87 || control->size != 2 ||
+		    control->offset != 87 || control->mute != 0)
+			return false;
+		found = true;
+	}
+	if (!found) return false;
+	setProperty("S540OutputRangeFixActive", true);
+	return true;
+}
