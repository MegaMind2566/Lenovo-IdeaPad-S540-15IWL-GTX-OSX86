+// This policy is tied to the codec graph observed on the S540, not merely its name.
+bool VoodooHDADevice::s540InputGainFixEnabled(PcmDevice *pcmDevice)
+{
+	if (!mEnableS540InputGainFix || mDeviceId != 0x9dc88086U || !pcmDevice ||
+	    !pcmDevice->funcGroup || !pcmDevice->funcGroup->codec ||
+	    CODEC_ID(pcmDevice->funcGroup->codec) != 0x10ec0257U ||
+	    pcmDevice->recChanId < 0 || pcmDevice->recChanId >= mNumChannels)
+		return false;
+
+	const int recAssoc = mChannels[pcmDevice->recChanId].assocNum;
+	bool adc = false, internalBoost = false, jackBoost = false;
+	AudioControl *control;
+	for (int i = 0; (control = audioCtlEach(pcmDevice->funcGroup, i)); i++) {
+		if (!control->enable || !control->widget ||
+		    control->widget->bindAssoc != recAssoc || control->step <= 0)
+			continue;
+		if (control->dir != HDA_CTL_IN || control->index != 0)
+			return false;
+		if (control->widget->nid == 8 &&
+		    control->ossmask == (SOUND_MASK_IMIX | SOUND_MASK_RECLEV) &&
+		    control->step == 63 && control->size == 2 && control->offset == 23 &&
+		    control->mute == 1) {
+			if (adc) return false;
+			adc = true;
+		} else if (control->step == 3 && control->size == 39 &&
+		           control->offset == 0 && control->mute == 0) {
+			if (control->widget->nid == 18 && control->ossmask == SOUND_MASK_MONITOR) {
+				if (internalBoost) return false;
+				internalBoost = true;
+			} else if (control->widget->nid == 25 && control->ossmask == SOUND_MASK_LINE) {
+				if (jackBoost) return false;
+				jackBoost = true;
+			} else {
+				return false;
+			}
+		} else {
+			return false;
+		}
+	}
+	if (!(adc && internalBoost && jackBoost))
+		return false;
+	setProperty("S540InputGainFixActive", true);
+	return true;
+}
